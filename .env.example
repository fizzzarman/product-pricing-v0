# Supabase pooled connection (port 6543, transaction mode) — used by the app at runtime
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase direct connection (port 5432) — used by prisma migrate
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Long random strings. ADMIN_SECRET gates /admin; CRON_SECRET gates /api/cron/sync-all.
ADMIN_SECRET=""
CRON_SECRET=""
